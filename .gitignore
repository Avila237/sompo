# Python
__pycache__/
*.py[cod]
*.egg-info/
dist/
build/
*.egg
.venv/
venv/
env/

# Dados e modelos (arquivos grandes)
data/*.csv
data/*.parquet
models/*.pkl
models/*.joblib
!data/.gitkeep
!models/.gitkeep

# Environment
.env

# IDE
.vscode/
.idea/
*.swp
*.swo

# Configuração local de ferramentas de agente.
# Ignora o conteudo, nao o diretorio: com '.claude/' o Git nem percorre a pasta
# e a excecao abaixo nunca seria avaliada.
.claude/*
# Excecao: o handoff precisa atravessar entre as maquinas
!.claude/handoff.md

# Material de terceiros (decks e artigos de referência) — citar, não versionar
docs/references/*.pdf

# OS
.DS_Store
Thumbs.db

# MLflow
mlruns/

# Jupyter
.ipynb_checkpoints/

# Node (mobile)
node_modules/
*.lock

# Arduino/ESP32
firmware/.pio/
firmware/build/