# === API Externa ===
OPENMETEO_BASE_URL=https://api.open-meteo.com/v1

# === Modelo ===
MODEL_PATH=./models/xgboost_model.joblib
MLFLOW_TRACKING_URI=file:./mlruns

# === App ===
API_BASE_URL=http://localhost:8000

# === Segurança (definir em produção) ===
JWT_SECRET_KEY=trocar-em-producao
JWT_ALGORITHM=HS256

# === Supabase (backend / scripts de seed) ===
SUPABASE_URL=https://seu-projeto.supabase.co
SUPABASE_KEY=sua-chave-aqui

# === Dashboard ===
# O frontend não recebe mais chave de banco (RF-07): ele fala só com a API.
# Ver dashboard/.env.example — a única variável é VITE_API_BASE_URL.