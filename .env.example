# === API Externa ===
OPENMETEO_BASE_URL=https://api.open-meteo.com/v1

# === Modelo ===
MODEL_PATH=./models/xgboost_model.joblib
MLFLOW_TRACKING_URI=file:./mlruns

# === App ===
API_BASE_URL=http://localhost:8000

# === Segurança (definir em produção) ===
JWT_SECRET_KEY=trocar-em-producao
JWT_ALGORITHM=HS256

# === Supabase (backend / scripts de seed) ===
SUPABASE_URL=https://seu-projeto.supabase.co
SUPABASE_KEY=sua-chave-aqui

# === Supabase (dashboard) — copie estes para dashboard/.env.local ===
# O Vite expõe ao frontend apenas variáveis com prefixo VITE_
VITE_SUPABASE_URL=https://seu-projeto.supabase.co
VITE_SUPABASE_KEY=sua-chave-aqui