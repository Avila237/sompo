# Copie para .env (nunca versionado) e troque todos os placeholders.
# Referência do que é lido: backend/core/config.py

# === Supabase (obrigatórias) ===
SUPABASE_URL=https://seu-projeto.supabase.co
# service_role: superusuário do banco. Só no servidor, nunca no frontend, nunca no Git.
# Usada pela API e pelos scripts de carga. SUPABASE_KEY é o nome antigo, ainda aceito.
SUPABASE_SERVICE_ROLE_KEY=defina-no-env-local
# Opcional: só o scripts/demo.sh usa, para provar que a leitura anônima é bloqueada pela RLS.
SUPABASE_ANON_KEY=

# === Segurança (obrigatórias) ===
# Mínimo de 32 bytes; a API não sobe com menos. Gere com:
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=troque-por-token-hex-32
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=480
# Usuários NÃO ficam aqui: vivem na tabela `usuarios`, com senha em hash (S4-18).
# Cadastro: python scripts/criar_usuario.py <usuario> --perfil <analista|gestor|tecnico|operador>

# === Open-Meteo ===
OPENMETEO_BASE_URL=https://api.open-meteo.com/v1
OPENMETEO_TIMEOUT_S=5

# === API ===
# Origens do dashboard autorizadas pelo CORS.
API_CORS_ORIGINS=http://localhost:5173,http://localhost:5175

# === Modelo ===
MODELS_DIR=models
MODELO_VERSAO=xgboost-v1-baseline

# === Dashboard ===
# O frontend não recebe chave de banco: fala só com a API.
# Ver dashboard/.env.example — a única variável é VITE_API_BASE_URL.
