# Ambiente local — referências ao 1Password, NENHUM valor secreto aqui.
# Rode com:  op run --env-file=.env.op -- <comando>
# Cofre "dev" (Mac: desbloqueio pelo app; VPS: Service Account vps-dev-2026-10).
# ⚠️ Não cite o esquema de referência do 1Password em comentário: o op também o resolve ali.

SUPABASE_URL=op://dev/sompo/SUPABASE_URL
SUPABASE_SERVICE_ROLE_KEY=op://dev/sompo/SUPABASE_SERVICE_ROLE_KEY
# Mesmo valor da service_role (era duplicada no .env antigo).
SUPABASE_KEY=op://dev/sompo/SUPABASE_SERVICE_ROLE_KEY
SUPABASE_ANON_KEY=op://dev/sompo/SUPABASE_ANON_KEY
JWT_SECRET_KEY=op://dev/sompo/JWT_SECRET_KEY

# Configuração não secreta (valores locais).
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=480
OPENMETEO_BASE_URL=https://api.open-meteo.com/v1
OPENMETEO_TIMEOUT_S=5
API_CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175
MODELS_DIR=models
MODELO_VERSAO=xgboost-v1.1
MLFLOW_TRACKING_URI=file:./mlruns
