# Base da API do backend (FastAPI). Unica variavel que o dashboard precisa.
#
# O Vite so expoe ao browser variaveis com prefixo VITE_. Nenhuma credencial
# entra aqui: usuario e senha sao digitados na tela de login e trocados por um
# JWT em POST /auth/token. A chave do Supabase saiu do frontend (RF-07).
#
# Copie para dashboard/.env.local (ignorado pelo Git via *.local).
VITE_API_BASE_URL=http://localhost:8000
